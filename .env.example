# Aegis AI — environment configuration
#
# Copy to `.env` and fill in the required values:
#     cp .env.example .env
#
# `.env` is git-ignored. Never commit real credentials.

# =============================================================================
# REQUIRED
# =============================================================================

# Anthropic API key. Generation is disabled without it; the rest of the
# platform still runs so you can explore the interface.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-placeholder

# Signing key for JWTs. Generate a fresh one — do not reuse this placeholder:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# =============================================================================
# DATABASE
# =============================================================================

# PostgreSQL is the platform database of record.
# Docker Compose builds this URL for you from the POSTGRES_* values below.
# For local development without Docker, the SQLite fallback needs no server:
#     DATABASE_URL=sqlite+aiosqlite:///./aegis.db
DATABASE_URL=postgresql+asyncpg://aegis:aegis_password@localhost:5432/aegis

POSTGRES_USER=aegis
POSTGRES_PASSWORD=aegis_password
POSTGRES_DB=aegis
POSTGRES_PORT=5432

# =============================================================================
# APPLICATION
# =============================================================================

ENVIRONMENT=development          # development | staging | production
DEBUG=true                       # must be false in production
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=console               # console | json  (use json in production)

API_PORT=8000
WEB_PORT=5173

# Comma-separated origins permitted to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# =============================================================================
# LANGUAGE MODEL
# =============================================================================

LLM_MODEL=claude-opus-5
LLM_EFFORT=high                  # low | medium | high | xhigh | max
LLM_MAX_TOKENS=32000
LLM_MAX_RETRIES=3
LLM_TIMEOUT_SECONDS=900

# =============================================================================
# GENERATION LIMITS
# =============================================================================

MAX_CONCURRENT_RUNS=4            # runs allowed in flight at once
MAX_FILES_PER_PROJECT=400
MAX_FILE_BYTES=512000
GENERATION_BATCH_SIZE=4          # files generated per model call
ARTIFACT_ROOT=./artifacts
ARTIFACT_RETENTION_DAYS=30

# =============================================================================
# BOOTSTRAP ADMIN (optional)
# =============================================================================
# When both are set, this account is created on first start.

BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
