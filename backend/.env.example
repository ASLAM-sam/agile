# =============================================================================
# AEGIS AI — ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================================
# DO NOT put real secrets into this example file.
# Copy to backend/.env and populate actual keys from your environment.
#
#     cd backend
#     cp .env.example .env
#
# =============================================================================

# ------------------------------------------------------------
# CORE APPLICATION
# ------------------------------------------------------------
APP_ENV=development
ENVIRONMENT=development
DATABASE_URL=sqlite+aiosqlite:///./aegis.db
SECRET_KEY=change-this-in-production-use-a-32-byte-hex-string
AEGIS_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
LOG_LEVEL=INFO

# ------------------------------------------------------------
# DEFAULT ROUTING
# ------------------------------------------------------------
DEFAULT_PROVIDER=gemini
# Accepted alias: DEFAULT_LLM_PROVIDER=gemini
DEFAULT_MODEL=gemini-3.6-flash
# Accepted alias: DEFAULT_LLM_MODEL=gemini-3.6-flash

# ------------------------------------------------------------
# REQUEST BUDGET
# ------------------------------------------------------------
TARGET_REQUESTS_PER_TASK=10
# Accepted alias: LLM_REQUEST_TARGET=10
HARD_MAX_REQUESTS_PER_TASK=15
# Accepted alias: LLM_REQUEST_HARD_MAX=15

# ------------------------------------------------------------
# FRONTEND DEFAULT
# ------------------------------------------------------------
DEFAULT_FRONTEND_STACK=html_css_js

# ------------------------------------------------------------
# AUTHORITATIVE 7-AGENT MODEL ARCHITECTURE
# ------------------------------------------------------------
PLANNER_MODEL=nvidia/nemotron-3-super-120b-a12b
FRONTEND_MODEL=gemini-3.6-flash
BACKEND_MODEL=gemini-3.6-flash
DATABASE_MODEL=gemini-3.6-flash
QA_MODEL=nvidia/nemotron-3-super-120b-a12b
REVIEW_MODEL=nvidia/nemotron-3-super-120b-a12b
DEBUG_MODEL=nvidia/nemotron-3-super-120b-a12b

# Exactly 7 primary API key slots (No account hopping, no 8th slot)
PLANNER_API_KEY01=
FRONTEND_API_KEY01=
BACKEND_API_KEY01=
DATABASE_API_KEY01=
QA_API_KEY01=
REVIEW_API_KEY01=
DEBUG_API_KEY01=

# NVIDIA NIM Configuration (for Nemotron slots)
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
NVIDIA_API_KEY=

LLM_TARGET_REQUESTS=10
LLM_HARD_MAX_REQUESTS=15


# ------------------------------------------------------------
# GEMINI CONFIGURATION (gemini-3.6-flash ONLY)
# ------------------------------------------------------------
GEMINI_MODEL=gemini-3.6-flash
GEMINI_BASE_URL=
GEMINI_API_KEY=

# ------------------------------------------------------------
# OPENAI CONFIGURATION
# ------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ------------------------------------------------------------
# MISTRAL CONFIGURATION
# ------------------------------------------------------------
MISTRAL_API_KEY=
MISTRAL_BASE_URL=https://api.mistral.ai/v1
MISTRAL_MODEL=mistral-large-latest

# ------------------------------------------------------------
# GITHUB MODELS
# ------------------------------------------------------------
GITHUB_TOKEN=
GITHUB_MODELS_BASE_URL=https://models.inference.ai.azure.com
GITHUB_MODELS_MODEL=gpt-4o

# ------------------------------------------------------------
# GROQ
# ------------------------------------------------------------
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

# ------------------------------------------------------------
# DEEPSEEK
# ------------------------------------------------------------
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ------------------------------------------------------------
# SAMBANOVA
# ------------------------------------------------------------
SAMBANOVA_API_KEY=
SAMBANOVA_BASE_URL=https://api.sambanova.ai/v1
SAMBANOVA_MODEL=Meta-Llama-3.1-70B-Instruct


# ------------------------------------------------------------
# OLLAMA
# ------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3

