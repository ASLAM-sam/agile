# Aegis AI — environment configuration
#
# This file belongs to the backend, which is the only component that reads it.
# Copy it in place and fill in the required values:
#
#     cd backend
#     cp .env.example .env
#
# `app/core/config.py` resolves `backend/.env` by absolute path, so uvicorn,
# pytest and alembic all read it regardless of which directory you run them
# from. Real environment variables always win over this file.
#
# Docker Compose reads it too, but must be told where it is:
#
#     docker compose --env-file ./backend/.env up --build
#
# `.env` is git-ignored. Never commit real credentials.

# =============================================================================
# REQUIRED
# =============================================================================

# The PREFERRED provider: anthropic | gemini | groq | nvidia | openai | ollama
# It is tried first. Every other provider that holds credentials stays behind
# it as an automatic fallback, so a run continues when this one hits its quota.
LLM_PROVIDER=anthropic

# Fallback order after the preferred provider. Unknown names are ignored.
LLM_PROVIDER_PRIORITY=gemini,groq,nvidia,ollama,openai,anthropic

# Providers to switch off entirely, whatever credentials they hold.
LLM_DISABLED_PROVIDERS=

# Needed when LLM_PROVIDER=anthropic.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Needed when LLM_PROVIDER=gemini. Google AI Studio issues free-tier keys.
# Get one at https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Groq — fast, generous free tier. https://console.groq.com/keys

# NVIDIA NIM — large-context open models, free credits to start.
# Get a key at https://build.nvidia.com (it looks like nvapi-...).
NVIDIA_API_KEY=

# OpenAI — paid. https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Signing key for JWTs. Generate a fresh one — do not reuse this placeholder:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# =============================================================================
# DATABASE
# =============================================================================

# PostgreSQL is the platform database of record.
# Docker Compose builds this URL for you from the POSTGRES_* values below.
# For local development without Docker, the SQLite fallback needs no server:
#     DATABASE_URL=sqlite+aiosqlite:///./aegis.db
DATABASE_URL=postgresql+asyncpg://aegis:aegis_password@localhost:5432/aegis

POSTGRES_USER=aegis
POSTGRES_PASSWORD=aegis_password
POSTGRES_DB=aegis
POSTGRES_PORT=5432

# =============================================================================
# APPLICATION
# =============================================================================

ENVIRONMENT=development          # development | staging | production
DEBUG=true                       # must be false in production
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=console               # console | json  (use json in production)

API_PORT=8000
WEB_PORT=5173

# Comma-separated origins permitted to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# =============================================================================
# LANGUAGE MODEL
# =============================================================================

# Used when LLM_PROVIDER=anthropic.
LLM_MODEL=claude-opus-5

# Used when LLM_PROVIDER=gemini. Flash models carry the free-tier allowance.
# Note that older ids such as gemini-2.5-flash are closed to new API keys.
GEMINI_MODEL=gemini-3.6-flash

GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Groq's free tier bills input AND output against one per-minute budget
# (12k TPM). Asking for the platform-wide LLM_MAX_TOKENS would be rejected
# outright, so requests to Groq are clamped to these instead. Raise them if
# you upgrade tier; a prompt larger than the prompt budget is routed to a
# provider that can hold it.
GROQ_MAX_PROMPT_TOKENS=8000
GROQ_MAX_OUTPUT_TOKENS=3500

# NVIDIA NIM. Any model id from the build.nvidia.com catalogue works, e.g.
# nvidia/nemotron-3-ultra-550b-a55b, deepseek-ai/deepseek-r1,
# qwen/qwen2.5-coder-32b-instruct. Point NVIDIA_BASE_URL at your own machine
# (http://localhost:8000/v1) to use a self-hosted NIM container instead.
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# How this model is asked for JSON: json_schema (the model enforces a supplied
# schema) | json_object (valid JSON only) | prompt (neither). NIM support
# varies per model, so it is declared rather than assumed. Output is validated
# locally in every mode, so the weakest one is still safe — just less
# efficient. Drop to `prompt` if the model answers 400 to response_format.
NVIDIA_STRUCTURED_OUTPUT=json_object

# Context limits for the model above. NIM's catalogue runs from 8k to well
# beyond 128k, so nothing is assumed: 0 means "no declared limit". Setting
# them lets routing skip NVIDIA for a prompt it could not hold, instead of
# spending a round trip to be told so.
NVIDIA_MAX_PROMPT_TOKENS=0
NVIDIA_MAX_OUTPUT_TOKENS=0

OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Ollama runs locally and needs no key. Set OLLAMA_ENABLED=true once
# `ollama serve` is running and the model has been pulled.
OLLAMA_ENABLED=false
OLLAMA_MODEL=llama3.1
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MAX_PROMPT_TOKENS=6000
OLLAMA_MAX_OUTPUT_TOKENS=4096

# =============================================================================
# RESILIENCE
# =============================================================================

# Move to the next provider when one hits a quota, rejects its key, or fails.
LLM_FAILOVER_ENABLED=true

# Prefer cheaper providers for documentation and summaries, stronger ones for
# reasoning and code. Preference only — every provider stays reachable.
LLM_TASK_ROUTING_ENABLED=true

# How long a provider sits out after a quota or credential rejection.
LLM_QUOTA_COOLDOWN_SECONDS=300
# How long it sits out after repeated ordinary failures, and how many.
LLM_FAILURE_COOLDOWN_SECONDS=60
LLM_FAILURE_THRESHOLD=3

# Serve an identical prompt from memory instead of calling a provider again.
LLM_CACHE_ENABLED=true
LLM_CACHE_MAX_ENTRIES=512
LLM_CACHE_TTL_SECONDS=3600

# Anthropic-only. Gemini sizes its own thinking budget and ignores this.
LLM_EFFORT=high                  # low | medium | high | xhigh | max

LLM_MAX_TOKENS=32000
LLM_MAX_RETRIES=3
LLM_TIMEOUT_SECONDS=900

# =============================================================================
# GENERATION LIMITS
# =============================================================================

MAX_CONCURRENT_RUNS=4            # runs allowed in flight at once
MAX_FILES_PER_PROJECT=400
MAX_FILE_BYTES=512000
GENERATION_BATCH_SIZE=4          # files generated per model call
ARTIFACT_ROOT=./artifacts
ARTIFACT_RETENTION_DAYS=30

# =============================================================================
# BOOTSTRAP ADMIN (optional)
# =============================================================================
# When both are set, this account is created on first start.

BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
